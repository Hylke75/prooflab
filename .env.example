# Supabase (Project settings → API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public base URL of the app; used for magic-link redirects and shareable test links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Shared secret that the public test-page routes pass to the ingest RPCs.
# Store sha256(INGEST_SECRET) in public.ingest_keys (see README → Setup).
INGEST_SECRET=

# Server-only. Salt for the cookieless visitor hash on test pages and for personal survey links (version "v1").
TRACKING_SALT=

# Server-only, optional. Versioned salts for rotation, first = current: "v2:newsecret,v1:oldsecret"
# (each secret at least 16 characters, no commas). Invitations remember their version; keep old versions listed
# while invitations created under them are still running. TRACKING_SALT is used as v1 when v1 is not listed.
TRACKING_SALTS=

# Server-only, optional. AI providers: Claude (Anthropic), ChatGPT (OpenAI), Gemini (Google). One key is enough
# to enable AI research, planning, interview analysis, the coach and the AI part of the Reality Check; with more
# keys, web research and the AI forecast run on every connected provider (per organisation, see Systeemstatus).
# Without any key ProofLab shows "AI niet verbonden" and works manually.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides per provider (defaults in lib/ai/providers/config.ts). Prices for the cost ledger are
# listed there too; an unlisted model is priced at its provider's default model.
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Optional: the cheaper model per provider for web search, reading sources and support checks (defaults in
# lib/ai/providers/config.ts DEFAULT_RESEARCH_MODELS). The heavy model above only plans and runs the reality check.
ANTHROPIC_RESEARCH_MODEL=
OPENAI_RESEARCH_MODEL=
GEMINI_RESEARCH_MODEL=

# Server-only, optional. Sends personal survey invitations through the Resend HTTP API. Without them ProofLab
# shows "e-mail niet gekoppeld" and offers a CSV of personal links to mail from your own program.
# EMAIL_FROM must be an address on a domain verified in Resend, e.g. "Onderzoek <onderzoek@jouwdomein.nl>".
RESEND_API_KEY=
EMAIL_FROM=

# Server-only, optional. Only used to create one-time sign-in links for client invitations (Supabase admin
# generateLink). Leave empty for the safest default: the invitation links to /login?email=… and the client requests a
# magic link there. See docs/OPERATIONS.md §10. Never expose this key to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Bearer secret (16+ characters) for the background job worker /api/jobs/run. Vercel Cron sends
# "Authorization: Bearer $CRON_SECRET" automatically (vercel.json, every minute; that schedule needs Vercel Pro).
# Without a per-minute cron the app also runs the worker right after enqueueing and while the page polls progress.
CRON_SECRET=

# Server-only, optional. Signing secret ("whsec_...") of the Resend webhook pointing to <app>/api/email/resend
# (events email.bounced and email.complained). Hard bounces and spam complaints then stop further mail.
RESEND_WEBHOOK_SECRET=

# Server-only, optional. Per-run research budget cap in USD (default 3).
RESEARCH_BUDGET_USD=3

# Server-only, optional. Report server errors to a Sentry-compatible endpoint (Sentry, GlitchTip, Bugsink, ...)
# without an SDK. Without it errors are only written as redacted JSON log lines. See docs/OPERATIONS.md.
SENTRY_DSN=
# Optional labels on reported errors (default: VERCEL_ENV / VERCEL_GIT_COMMIT_SHA).
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Optional. Account for npm run dogfood and the E2E journey (dogfood falls back to E2E_*).
E2E_EMAIL=
E2E_PASSWORD=
DOGFOOD_EMAIL=
DOGFOOD_PASSWORD=

# Fase 1 · punt 3: Fathom als bron van interviewtranscripten (optioneel). Standaard uit: importeren via een bestand
# werkt altijd. De API-sleutel staat per werkruimte in de database (statuspagina, eigenaar), niet hier.
FATHOM_ENABLED=
# Optioneel: andere basis-URL van de Fathom-API (standaard https://api.fathom.ai/external/v1).
FATHOM_API_URL=
