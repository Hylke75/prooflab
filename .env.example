# Supabase (Project settings → API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public base URL of the app; used for magic-link redirects and shareable test links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Shared secret that the public test-page routes pass to the ingest RPCs.
# Store sha256(INGEST_SECRET) in public.ingest_keys (see README → Setup).
INGEST_SECRET=

# Server-only. Salt for the daily rotating, cookieless visitor hash on test pages.
TRACKING_SALT=

# Server-only, optional. Enables AI research, planning, interview analysis and the AI part
# of the Reality Check. Without it ProofLab shows "AI niet verbonden" and works manually.
ANTHROPIC_API_KEY=

# Server-only, optional. Per-run research budget cap in USD (default 3).
RESEARCH_BUDGET_USD=3

# Optional. Account for npm run dogfood and the E2E journey (dogfood falls back to E2E_*).
E2E_EMAIL=
E2E_PASSWORD=
DOGFOOD_EMAIL=
DOGFOOD_PASSWORD=
